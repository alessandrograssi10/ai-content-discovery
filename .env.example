# TMDb API v4 Read Access Token (the long JWT-style string, NOT the short v3 API key).
# Get it from: https://www.themoviedb.org/settings/api -> "API Read Access Token"
TMDB_API_KEY=your_tmdb_read_access_token_here

# OpenAI API key
# Used for: gpt-5.4-mini (enrichment) + text-embedding-3-small (embeddings).
OPENAI_API_KEY=your_openai_api_key_here
